    <!-- Distro Descriptions -->
    <string name="desc_ubuntu">Popular, user-friendly distro with excellent community support and LTS releases</string>
    <string name="desc_arch">Lightweight, rolling release distro for advanced users who want full control</string>
    <string name="desc_fedora">Cutting-edge distro with latest technologies, backed by Red Hat</string>
    <string name="desc_debian">Rock-solid stable foundation, parent of Ubuntu and many other distros</string>
    <string name="desc_kali">Penetration testing and security auditing distro with 600+ tools</string>
    <string name="desc_alpine">Tiny, security-focused distro using musl libc and busybox (~5MB)</string>
    <string name="desc_manjaro">User-friendly Arch-based distro with graphical installer and held-back updates</string>
    <string name="desc_opensuse">Professional-grade distro with YaST config tool, Leap (stable) and Tumbleweed (rolling)</string>
    <string name="desc_void">Independent rolling distro with runit init, XBPS package manager, and musl/glibc options</string>
    <string name="desc_gentoo">Source-based distro with extreme customization via USE flags and Portage</string>

